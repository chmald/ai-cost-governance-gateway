{
  "name": "@gateway/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:seed": "tsx src/cli.ts seed",
    "test:integration": "tsx --test test/integration/pg.test.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
