# Copy to .env for loopback-only local use. Never commit .env or real credentials.
# Demo is explicitly forbidden when NODE_ENV=production or HOST is not loopback.
GATEWAY_MODE=demo
HOST=127.0.0.1
PORT=3001
# Durable embedded Postgres requires neither Docker nor an Azure account.
# Relative PGlite paths resolve from the repository root; data/ is gitignored.
# Run one server/CLI per embedded database. After an unclean shutdown, remove the
# sibling data/gateway.gateway.lock ONLY after confirming the recorded PID has stopped.
# This does not release any ledger reservations. Prefer PostgreSQL for multiple processes.
DATABASE_URL=pglite://data/gateway
# DATABASE_AUTH defaults to password for the existing manual PostgreSQL/PGlite flows.
# azd sets DATABASE_AUTH=entra plus GATEWAY_MODE=azure and a required AZURE_CLIENT_ID.
# Entra DATABASE_URL has no password; use the Azure server FQDN, port 5432, and only
# sslmode=verify-full. PostgreSQL tokens come only from that managed identity per connection.
# Optional Docker PostgreSQL alternative (replace the example password locally):
# DATABASE_URL=postgresql://gateway:local-only-change-me@127.0.0.1:5432/gateway

# Azure mode requires PostgreSQL with sslmode=verify-full, no embedded or credential fallback.
# User access token audience, delegated scope, and fixed single tenant:
# (App-only callers - agents, managed identities, service principals - need no extra setting:
#  assign them the Application-only Gateway.Agent role on the user API and register their
#  service-principal object ID on a team as an application identity.)
AZURE_TENANT_ID=
ENTRA_SPA_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_API_SCOPE=
# Separate APIM managed-identity proof: application role Gateway.Invoke.
# Both audience settings are distinct API application GUIDs for v2 tokens, not api:// URIs.
GATEWAY_API_AUDIENCE=
APIM_PRINCIPAL_ID=
AZURE_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
# Account-root HTTPS URL, e.g. https://your-account.openai.azure.com/
FOUNDRY_ENDPOINT=
APIM_RESOURCE_GROUP=
APIM_SERVICE_NAME=
# APIM origin, e.g. https://your-gateway.azure-api.net
APIM_GATEWAY_URL=
# Optional user-assigned identity for ARM/Foundry; required runtime identity for DATABASE_AUTH=entra.
AZURE_CLIENT_ID=
# Cloud-only bootstrap: node apps/api/dist/bootstrap.js (never runs demo seed).
# The job requires GATEWAY_MODE=azure, DATABASE_AUTH=entra, AZURE_CLIENT_ID (migration MI),
# POSTGRES_HOST, POSTGRES_DATABASE, POSTGRES_APP_ROLE, MIGRATION_PRINCIPAL_NAME,
# and RUNTIME_PRINCIPAL_ID (runtime MI object ID). Do not pass DATABASE_URL to the job.
# Bootstrap never loads this .env file; only the job's explicit environment is consumed.
# Comma-separated exact hostnames and trusted managed-identity resource audiences.
# Both lists are empty/fail-closed by default. External tool costs are NOT covered.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_AUDIENCES=
# Optional dedicated PostgreSQL test database only; integration tests drop their own schema.
# TEST_DATABASE_URL=postgresql://gateway:local-only-change-me@127.0.0.1:5432/gateway
