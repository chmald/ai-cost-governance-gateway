<mxfile host="Electron" version="26.0.0"><diagram id="configuration-flow" name="configuration-flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="880" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="810" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Configuration flow — sources, precedence, consumers&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1740" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Most settings are azd environment values. Explicit values win; ${NAME=default} supplies the rest; setup-derived values are validated, not guessed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="40" as="geometry"/></mxCell><mxCell id="footer" value="AI Cost Governance Gateway  |  Configuration flow (docs/12)  |  v0.3.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="852" width="1740" height="18" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Sources&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#0078D4;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=folder;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="520" height="700" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b style=&quot;font-size:13px&quot;&gt;azd environment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;azd env set NAME value&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;.azure/&amp;lt;env&amp;gt;/.env (gitignored)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="480" height="90" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Setup hooks (run.mjs)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;save ENTRA_*, GATEWAY_AGENT_ROLE_ID&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;FOUNDRY_ENDPOINT derived + checked&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;iconKey=powershell;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="480" height="90" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b style=&quot;font-size:13px&quot;&gt;Bicep outputs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;UPPER_SNAKE_CASE → azd env&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;e.g. APIM_GATEWAY_URL, DATABASE_URL&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;iconKey=resource-group;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="480" height="90" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Manual parameter file&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;infra/main.parameters.local.json&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;Key Vault reference for DATABASE_URL&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="480" height="90" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b style=&quot;font-size:13px&quot;&gt;Local .env&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;copied from .env.example&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;loopback demo / local dev only&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=dev-console;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="480" height="90" as="geometry"/></mxCell><mxCell id="s7" value="&lt;b&gt;Precedence&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#5C2D91;fontFamily=Segoe UI;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="400" height="700" as="geometry"/></mxCell><mxCell id="x8" value="&lt;b&gt;1.&lt;/b&gt; Explicit &lt;i&gt;azd env set&lt;/i&gt; value&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Default in main.parameters.json&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;e.g. ${APIM_SKU=Developer}&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Value saved by a setup hook&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(validated on every run)&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Bicep output written back&lt;br&gt;&lt;br&gt;&lt;b&gt;Never:&lt;/b&gt; the ambient CLI tenant,&lt;br&gt;a guessed endpoint, or a secret." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="600" y="170" width="360" height="330" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Validated by setup&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;tenant ↔ subscription&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Foundry endpoint ↔ account&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;user ≠ proof audience&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.