<mxfile host="Electron" version="26.0.0"><diagram id="loopback-demo-story" name="loopback-demo-story"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="720" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="810" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Offline loopback demo — the story in eight steps&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1740" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Runs on a laptop with simulated model replies and an embedded database. No Azure subscription and no model calls; loopback host only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="40" as="geometry"/></mxCell><mxCell id="footer" value="AI Cost Governance Gateway  |  Loopback demo (docs/00)  |  v0.3.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="692" width="1740" height="18" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Start&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;npm ci · copy .env.example&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-si