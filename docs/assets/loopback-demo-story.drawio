Y" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="94" y="631" width="73" height="18" as="geometry"/></mxCell><mxCell id="l27" value="loopback host; refused when NODE_ENV=production" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="173" y="630" width="303" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
