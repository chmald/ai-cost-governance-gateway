<mxfile host="Electron" version="26.0.0"><diagram id="azd-release-gate" name="azd-release-gate"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="760" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="810" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Release gate — the exact image must migrate before it serves&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1740" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Service predeploy runs after azd publish and before azd deploy. Every failure or uncertain outcome blocks the release." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="40" as="geometry"/></mxCell><mxCell id="footer" value="AI Cost Governance Gateway  |  azd integration contract (docs/11)  |  v0.3.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="732" width="1740" height="18" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Publish&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;ACR remote build&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;SERVICE_GATEWAY_IMAGE_NAME&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;iconKey=container-registry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="380" height="100" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="26" height="26" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Approve registry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;image must come from&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;this environment's ACR&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="485" y="150" width="380" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="475" y="140" width="26" height="26" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b style=&quot;font-size:13px&quot;&gt;Resolve digest&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;manifest → sha256&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;DIGEST_UNVERIFIED stops&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;iconKey=commit;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="380" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0078D4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="910" y="140" width="26" height="26" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Deploy job&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;migration-job.bicep&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;migration UAMI · that digest&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=container-apps-environment;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1355" y="150" width="380" height="100" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1345" y="140" width="26" height="26" as="geometry"/></mxCell><mxCell id="t9" value="&lt;b style=&quot;font-size:13px&quot;&gt;Run + wait&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;manual job · zero retries&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;600 s timeout&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="380" height="100" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="26" height="26" as="geometry"/></mxCell><mxCell id="t11" value="&lt;b style=&quot;font-size:13px&quot;&gt;Attest + save&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;execution used that image&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;GATEWAY_DEPLOY_IMAGE&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="485" y="390" width="380" height="100" as="geometry"/></mxCell><mx