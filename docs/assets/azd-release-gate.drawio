t="t9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1545" y="315"/><mxPoint x="240" y="315"/></Array></mxGeometry></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t9" target="t11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t11" target="t13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t13" target="t15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b24" value="&lt;b&gt;Release blocked&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;MIGRATION_DEPLOYMENT_FAILED · MIGRATION_OUTCOME_UNCERTAIN&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;MIGRATION_JOB_MISMATCH · MIGRATION_IMAGE_UNVERIFIED&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;previous revision keeps serving&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FBEFEF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="820" height="100" as="geometry"/></mxCell><mxCell id="e25" value="failed / uncertain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#A4262C;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t9" target="b24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x26" value="Covers &lt;b&gt;azd up&lt;/b&gt;, &lt;b&gt;azd deploy&lt;/b&gt; and &lt;b&gt;azd deploy --from-package&lt;/b&gt;. No hook calls azd deploy recursively. The job is tagged azd-env-name only, never azd-service-name." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="930" y="570" width="820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
