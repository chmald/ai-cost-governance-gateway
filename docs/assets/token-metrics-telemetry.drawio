p;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#107C10;fontFamily=Segoe UI;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=postgresql;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1760" height="200" as="geometry"/></mxCell><mxCell id="t22" value="&lt;b style=&quot;font-size:13px&quot;&gt;Governance API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;reserve → settle at snapshot price&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;actorType + clientAppId per row&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="400" height="90" as="geometry"/></mxCell><mxCell id="t23" value="&lt;b style=&quot;font-size:13px&quot;&gt;PostgreSQL ledger&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;reservations · audit&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;integer microdollars&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=postgresql;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="520" y="670" width="380" height="90" as="geometry"/></mxCell><mxCell id="t24" value="&lt;b style=&quot;font-size:13px&quot;&gt;Portal Activity + /api/usage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;charged USD by team, model, caller&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;user vs app attribution&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=browser;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="670" width="380" height="90" as="geometry"/></mxCell><mxCell id="e25" value="to the API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="t6" target="t22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="595"/><mxPoint x="470" y="595"/><mxPoint x="470" y="697"/></Array></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t22" target="t23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t23" target="t24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x28" value="Use metrics for trends and anomalies; use the ledger for money. They should agree on tokens, not necessarily on timing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1400" y="670" width="360" height="90" as="geometry"/></mxCell><mxCell id="lg29" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="60" height="20" as="geometry"/></mxCell><mxCell id="p30" value="OPT-IN" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#5C2D91;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="94" y="831" width="53" height="18" as="geometry"/></mxCell><mxCell id="l31" value="set LLM_TOKENS_PER_MINUTE_PER_CALLER above 0" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="153" y="830" width="284" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
