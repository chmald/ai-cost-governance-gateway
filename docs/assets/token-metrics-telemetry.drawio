ext. Invalid values become &lt;i&gt;invalid&lt;/i&gt; / &lt;i&gt;unknown&lt;/i&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="420" height="70" as="geometry"/></mxCell><mxCell id="s12" value="&lt;b&gt;Telemetry plane — token counts (observability)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#605E5C;fontFamily=Segoe UI;fillColor=#F3F2F1;strokeColor=#605E5C;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=monitor;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="960" y="110" width="820" height="470" as="geometry"/></mxCell><mxCell id="t13" value="&lt;b style=&quot;font-size:13px&quot;&gt;Application Insights&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;workspace-based · local auth disabled&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;APIM logger with managed identity&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;role Monitoring Metrics Publisher&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=application-insights;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="170" width="380" height="110" as="geometry"/></mxCell><mxCell id="t14" value="&lt;b style=&quot;font-size:13px&quot;&gt;Log Analytics workspace&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;custom metrics + logs&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;retention 30 days (default)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=log-analytics;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="980" y="330" width="380" height="90" as="geometry"/></mxCell><mxCell id="t15" value="&lt;b style=&quot;font-size:13px&quot;&gt;Chargeback views&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;Metrics explorer split by dimension&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;KQL · workbooks · alerts&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=workbooks;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1400" y="330" width="360" height="90" as="geometry"/></mxCell><mxCell id="t16" value="&lt;b style=&quot;font-size:13px&quot;&gt;Dimensions (max 5)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;API ID · Team ID · Model&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;Client App ID · Caller Type&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSi