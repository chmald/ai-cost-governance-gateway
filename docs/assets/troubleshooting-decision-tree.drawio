<mxfile host="Electron" version="26.0.0"><diagram id="troubleshooting-decision-tree" name="troubleshooting-decision-tree"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1080" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="810" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Troubleshooting decision tree&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1740" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Start from the symptom, find the product that owns it, apply the fix. Never release held money or weaken authentication to make a symptom disappear." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="40" as="geometry"/></mxCell><mxCell id="footer" value="AI Cost Governance Gateway  |  Troubleshooting (docs/05)  |  v0.3.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="1052" width="1740" height="18" as="geometry"/></mxCell><mxCell id="d1" value="azd up stops before&lt;br&gt;provisioning?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="260" height="120" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b style=&quot;font-size:13px&quot;&gt;azd + Entra ID&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;iconKey=entra-id;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="145" width="330" height="70" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;TENANT_MISMATCH / SUBSCRIPTION_UNAVAILABLE → sign in with --tenant-id and set AZURE_TENANT_ID + AZURE_SUBSCRIPTION_ID. Graph blocked → ENTRA_SETUP_MODE=existing with an administrator handoff.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="1010" height="100" as="geometry"/></mxCell><mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d6" value="Foundry network&lt;br&gt;restricted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="270" width="260" height="120" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b style=&quot;font-size:13px&quot;&gt;Microsoft Foundry&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="295" width="330" height="70" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;FOUNDRY_NETWORK_RESTRICTED → design routing, DNS or egress from the ACA VNet first, then set FOUNDRY_NETWORK_REVIEWED=true. Setup never opens the account firewall.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="280" width="1010" height="100" as="geometry"/></mxCell><mxCell id="e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6" target="t7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d11" value="Release blocked in&lt;br&gt;predeploy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="260" height="120" as="geometry"/></mxCell><mxCell id="t12" value="&lt;b style=&quot;font-size:13px&quot;&gt;Container Apps job + ACR&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;iconKey=container-apps;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="445" width="330" height="70" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;MIGRATION_* → inspect that job execution's logs, fix, rerun azd deploy gateway. ACR build fails → check npm registry reachability or pass NPM_CONFIG_REGISTRY.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="430" width="1010" height="100" as="geometry"/></mxCell><mxCell id="e14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d11" target="t12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t12" target="b13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d16" value="Inference returns&lt;br&gt;401 / 403?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="570" width="260" height="120" as="geometry"/></mxCell><mxCell id="t17" value="&lt;b style=&quot;font-size:13px&quot;&gt;API Management + Entra ID&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="595" width="330" height="70" as="geometry"/></mxCell><mxCell id="b18" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Audience = user API GUID (not api://). Role present? Caller oid on the team? APP_ROLE_REQUIRED → assign Gateway.Agent. GATEWAY_PROOF_REQUIRED → assign Gateway.Invoke to APIM.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="580" width="1010" height="100" as="geometry"/></mxCell><mxCell id="e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d16" target="t17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t17" target="b18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d21" value="402 BUDGET_EXCEEDED&lt;br&gt;or 502 HELD?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="260" height="120" as="geometry"/></mxCell><mxCell id="t22" value="&lt;b style=&quot;font-size:13px&quot;&gt;PostgreSQL ledger&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;iconKey=postgresql;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="745" width="330" height="70" as="geometry"/></mxCell><mxCell id="b23" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Held reservations still count. Check Activity for reserved / held rows. Reconcile only with provider evidence; raise the budget deliberately. Do not retry blindly.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="730" width="1010" height="100" as="geometry"/></mxCell><mxCell id="e24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d21" target="t22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t22" target="b23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d26" value="No token metrics in&lt;br&gt;App Insights?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="260" height="120" as="geometry"/></mxCell><mxCell id="t27" value="&lt;b style=&quot;font-size:13px&quot;&gt;Application Insights&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;iconKey=application-insights;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="360" y="895" width="330" height="70" as="geometry"/></mxCell><mxCell id="b28" value="&lt;b&gt;Fix&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Logger uses APIM managed identity + Monitoring Metrics Publisher; diagnostic has metrics: true; usage arrives only on non-streaming 200s; dimension caps drop new values.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="760" y="880" width="1010" height="100" as="geometry"/></mxCell><mxCell id="e29" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d26" target="t27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t27" target="b28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x31" value="No match? Run the offline checks in docs/04 first (npm test, validate:azd, Test-*.ps1), then capture the error code — every hook and API error carries a stable code listed in docs/05." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="1030" width="1740" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
