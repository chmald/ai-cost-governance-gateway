tools exist. Agents see only teams that register them, never peer identities. Policies set &lt;b&gt;buffer-response=false&lt;/b&gt;; no MCP body is logged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="420" y="292" width="1000" height="40" as="geometry"/></mxCell><mxCell id="p12" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="678" y="184" width="60" height="18" as="geometry"/></mxCell><mxCell id="s13" value="&lt;b&gt;B · External MCP server registration (operator-approved)&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#5C2D91;fontFamily=Segoe UI;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=policy;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="1760" height="420" as="geometry"/></mxCell><mxCell id="t14" value="&lt;b style=&quot;font-size:13px&quot;&gt;Admin in the portal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;Gateway.Admin&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;POST /api/mcp-servers&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=browser;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="300" height="90" as="geometry"/></mxCell><mxCell id="d15" value="Host in MCP_ALLOWED_HOSTS&lt;br&gt;and audience in&lt;br&gt;MCP_ALLOWED_AUDIENCES?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="390" y="430" width="290" height="130" as="geometry"/></mxCell><mxCell id="t16" value="&lt;b style=&quot;font-size:13px&quot;&gt;APIM MCP API created&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;type mcp · streamable · /mcp&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;policy from external-mcp.xml&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="740" y="450" width="340" height="90" as="geometry"/></mxCell><mxCell id="b17" value="&lt;b&gt;400 MCP_TARGET_REJECTED&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;empty allowlists deny all&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FBEFEF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="425" y="600" width="220" height="60" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t14" target="d15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#5C2D91;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d15" target="t16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#A4262C;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d15" target="b17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t21" value="&lt;b style=&quot;font-size:13px&quot;&gt;MCP client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;user or app-only token&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="740" y="690" width="340" height="80" as="geometry"/></mxCell><mxCell id="t22" value="&lt;b style=&quot;font-size:13px&quot;&gt;APIM external MCP API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;validates caller (user or Gateway.Agent)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;mints APIM MI token for the server&lt;/font&gt;" style="shape=l