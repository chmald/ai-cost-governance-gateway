<mxfile host="Electron" version="26.0.0"><diagram id="budget-admission-flow" name="budget-admission-flow"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bar1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="8" as="geometry"/></mxCell><mxCell id="bar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="990" y="0" width="810" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Budget admission — reserve, call, settle (or hold)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1740" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Money moves only inside one PostgreSQL transaction per step. Admission counts settled spend AND every outstanding reservation; uncertain outcomes keep their reservation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1740" height="40" as="geometry"/></mxCell><mxCell id="footer" value="AI Cost Governance Gateway  |  Budget admission flow (docs/06)  |  v0.3.0  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="1152" width="1740" height="18" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;A · Admission checks — no money moves&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#0078D4;fontFamily=Segoe UI;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=api-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1760" height="330" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Inference request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;POST …/chat/completions&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;X-Team-Id · max tokens&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;iconKey=users;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="270" height="90" as="geometry"/></mxCell><mxCell id="d3" value="APIM: valid Entra token&lt;br&gt;with a gateway role?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="d4" value="Within rate limit&lt;br&gt;(and optional&lt;br&gt;llm-token-limit)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="615" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="d5" value="API: caller token +&lt;br&gt;APIM proof + team&lt;br&gt;membership valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="890" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="d6" value="Supported shape,&lt;br&gt;model enabled,&lt;br&gt;pricing current?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="1165" y="160" width="220" height="110" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;401 / 403 at APIM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;no API call, no reservation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FBEFEF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="350" y="320" width="200" height="64" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;429 at APIM&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;no API call, no reservation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FBEFEF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="625" y="320" width="200" height="64" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;401 / 403 from the API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;APP_ROLE_REQUIRED&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;TEAM_ACCESS_DENIED&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;GATEWAY_PROOF_REQUIRED&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FBEFEF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="310" width="240" height="90" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;400 / 409 from the API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;STALE_PRICING · CONTEXT_LIMIT&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;streaming, tools, images rejected&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FBEFEF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1155" y="315" width="240" height="80" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#A4262C;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d3" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#A4262C;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#A4262C;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d5" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#A4262C;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x19" value="&lt;b&gt;Nothing reaches Foundry&lt;/b&gt; until every check in A passes. APIM rejections never create a reservation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1460" y="180" width="300" height="80" as="geometry"/></mxCell><mxCell id="s20" value="&lt;b&gt;B · Ledger transaction — row lock on the team's monthly budget&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#107C10;fontFamily=Segoe UI;fillColor=#F1F8EE;strokeColor=#107C10;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=postgresql;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1760" height="250" as="geometry"/></mxCell><mxCell id="t21" value="&lt;b style=&quot;font-size:13px&quot;&gt;Conservative maximum&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;context window × max(input, output) rate&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;+ bounded output allowance, rounded up&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=cost-management;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="330" height="90" as="geometry"/></mxCell><mxCell id="d22" value="settled + outstanding&lt;br&gt;+ new maximum&lt;br&gt;≤ monthly budget?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="440" y="512" width="240" height="116" as="geometry"/></mxCell><mxCell id="t23" value="&lt;b style=&quot;font-size:13px&quot;&gt;RESERVE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;status reserved · price snapshot&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;month, caller, actorType, client app&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=postgresql;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="760" y="530" width="330" height="90" as="geometry"/></mxCell><mxCell id="b24" value="&lt;b&gt;402 BUDGET_EXCEEDED&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;rejected before Foundry is called&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;held reservations still count&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;fillColor=#FBEFEF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="440" y="650" width="240" height="60" as="geometry"/></mxCell><mxCell id="e25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#0078D4;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6" target="t21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="215"/><mxPoint x="1420" y="455"/><mxPoint x="32" y="455"/><mxPoint x="32" y="575"/></Array></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t21" target="d22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="fits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#107C10;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d22" target="t23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#A4262C;strokeWidth=2;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;fontSize=11;fontColor=#A4262C;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d22" target="b24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x29" value="&lt;b&gt;Why the maximum?&lt;/b&gt; Output usage is unknown until the provider answers. Reserving the worst case means parallel requests can never spend the same balance twice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1160" y="540" width="600" height="70" as="geometry"/></mxCell><mxCell id="s30" value="&lt;b&gt;C · Inference and settlement — never retried&lt;/b&gt;" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontStyle=1;fontSize=14;spacingTop=8;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;fontColor=#CA5010;fontFamily=Segoe UI;fillColor=#FDF3EC;strokeColor=#CA5010;strokeWidth=1.5;dashed=1;dashPattern=6 4;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1760" height="350" as="geometry"/></mxCell><mxCell id="t31" value="&lt;b style=&quot;font-size:13px&quot;&gt;Call Foundry&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;managed identity · one attempt&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;no automatic retry, no replay&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;iconKey=foundry-models;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="50" y="880" width="300" height="90" as="geometry"/></mxCell><mxCell id="d32" value="Provider returned&lt;br&gt;valid usage within&lt;br&gt;the bound?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontColor=#201F1E;fontSize=11;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="410" y="860" width="240" height="130" as="geometry"/></mxCell><mxCell id="t33" value="&lt;b style=&quot;font-size:13px&quot;&gt;SETTLE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;charge actual tokens at snapshot price&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;unused headroom returns to the budget&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;iconKey=cost-budgets;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="760" y="785" width="380" height="80" as="geometry"/></mxCell><mxCell id="t34" value="&lt;b style=&quot;font-size:13px&quot;&gt;HELD&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;timeout · network error · missing usage&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;502 RESERVATION_HELD — no auto release&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;fontSize=12;iconKey=alerts;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="760" y="885" width="380" height="80" as="geometry"/></mxCell><mxCell id="t35" value="&lt;b style=&quot;font-size:13px&quot;&gt;INVALID_USAGE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;usage violates the configured bound&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot; style=&quot;font-size:12px&quot;&gt;502 · model quarantined · money stays held&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=8;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;iconKey=policy;image=data:image/svg+xml,;" vertex="1" pare